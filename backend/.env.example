# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_resume_screener

# LLM API Keys (set at least one)
OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here

# LLM Provider: "openai" or "gemini"
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-1.5-flash

# App
APP_NAME=Smart Resume Screener
APP_ENV=development
DEBUG=true

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# API Key (leave empty to disable auth in dev)
API_KEY=

# Rate Limiting
RATE_LIMIT_SCREEN=10/minute
RATE_LIMIT_JOBS=20/minute
